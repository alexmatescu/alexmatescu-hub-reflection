# evidence-release working directories (raw archives + extracted screenshots
# + generated CSV/README staging — deliverables ship as GitHub Release
# assets, not as tracked repository files; see .claude/skills/evidence-release)
evidence/incoming
evidence/work
evidence/output

# safety net: a baseline/evidence zip should never sit under public/ (it gets
# swept into .output and into git on every build/push) — raw archives belong
# in evidence/incoming instead
public/baselines/*.zip

